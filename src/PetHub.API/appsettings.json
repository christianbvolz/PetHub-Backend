{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PetHub.API",
    "Audience": "PetHub.Client",
    "ExpirationMinutes": 60
  },
  "RefreshToken": {
    "ExpiresAtDays": 14
  },
  "AuthLifecycle": {
    "EmailVerificationExpiresHours": 24,
    "PasswordResetExpiresHours": 1,
    "FrontendBaseUrl": "http://localhost:5173",
    "VerifyEmailPath": "/verify-email",
    "ResetPasswordPath": "/reset-password"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "FromEmail": "noreply@pethub.local",
    "FromName": "PetHub",
    "EnableSsl": true
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  }
}
